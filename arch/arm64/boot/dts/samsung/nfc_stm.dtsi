&${ese_ap_ese_rst_parent} {
	ese_ap_ese_rst_default: ese_ap_ese_rst_default {
		GPIO_CONFIG_PUD_DRV(${ese_ap_ese_rst}, FUNC_INPUT, PULL_NONE, DRV_LV3);
		samsung,pin-con-pdn = <2>; /* PIN_PDN_INPUT */
		samsung,pin-pud-pdn = <PIN_PULL_NONE>;
	};
};

&${ese_spi_parent} {
	ese_spi_bus_suspend: ese_spi_bus_suspend {
		samsung,pins = SEC_GPIO(${ese_spi_clk}), SEC_GPIO(${ese_spi_mosi}), SEC_GPIO(${ese_spi_miso});
		samsung,pin-function = <0>; /* INPUT */
		samsung,pin-pud = <PIN_PULL_DOWN>; /* DOWN */
		samsung,pin-drv = <PIN_AP_DRV_LV1>;
		samsung,pin-con-pdn = <2>; /* PIN_PDN_INPUT */
		samsung,pin-pud-pdn = <PIN_PULL_DOWN>;
	};

	ese_spi_cs_suspend: ese_spi_cs_suspend {
		samsung,pins = SEC_GPIO(${ese_spi_cs});
		samsung,pin-function = <1>; /* OUTPUT */
		samsung,pin-pud = <PIN_PULL_NONE>; /* NONE */
		samsung,pin-drv = <PIN_AP_DRV_LV1>;
		samsung,pin-val = <1>;
		samsung,pin-con-pdn = <1>; /*OUT1*/
		samsung,pin-pud-pdn = <PIN_PULL_NONE>;
	};

	ese_spi_bus: ese_spi_bus {
		samsung,pins = SEC_GPIO(${ese_spi_clk}), SEC_GPIO(${ese_spi_mosi}), SEC_GPIO(${ese_spi_miso});
		samsung,pin-function = <2>;
		samsung,pin-pud = <PIN_PULL_NONE>;
		samsung,pin-drv = <PIN_AP_DRV_LV1>;
	};

	ese_spi_cs: ese_spi_cs {
		samsung,pins = SEC_GPIO(${ese_spi_cs});
		samsung,pin-function = <1>;
		samsung,pin-pud = <PIN_PULL_NONE>;
		samsung,pin-drv = <PIN_AP_DRV_LV1>;
	};
};

&${ese_spi} {
	status = "ok";
	pinctrl-names = "default";
	pinctrl-0 = <&ese_spi_bus &ese_spi_cs>;

	st54spi: st54spi@0 {
		compatible = "st,st54spi";
		reg = <0>;
		spi-max-frequency = <1000000>;
		/*gpio-power_nreset-std = <SEC_GPIO_REF(${ese_power_reset}) 0>;*/
		st54spi,ap-ese-rst = <SEC_GPIO_REF(${ese_ap_ese_rst}) 0>;
		power_mode = "ST54J";
		st54spi,ap_vendor = "slsi";
#if 0
		ese-det-gpio = <SEC_GPIO_REF(${ese_check}) 0>;
#endif
		pinctrl-names = "default";
		pinctrl-0 = <&ese_ap_ese_rst_default
#if 0
			&ese_check_default
#endif
			>;

		gpio-controller;
		#gpio-cells = <2>;
		st54spi,cs-gpio = <SEC_GPIO_REF(${ese_spi_cs}) 0>;
		controller-data {
			samsung,spi-feedback-delay = <0>;
			samsung,spi-chip-select-mode = <0>;
		};
	};
};
#endif
