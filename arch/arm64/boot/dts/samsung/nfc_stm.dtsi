&hsi2c_5 {
	status = "ok";
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
#if 0
	pinctrl-names = "default", "i2c_pull_up";
	pinctrl-0 = <&nfc_i2c_no_change>;
	pinctrl-1 = <&nfc_i2c_pull_up>;
#else
	pinctrl-names = "default";
	pinctrl-0 = <&nfc_i2c_pull_none>;
#endif
	samsung,reset-before-trans;
	clock-frequency = <400000>; /* for HWI2C */
	samsung,i2c-max-bus-freq = <400000>; /* for Normal HW I2C */
	st21nfc: st21nfc@08 {
		compatible = "st,st21nfc";
		reg = <0x08>;
		interrupt-parent = <SEC_GPIO_TYPE(AP,gpm19,gpm19,0)>;
		interrupts = <SEC_GPIO_NUM(AP,gpm19,gpm19,0) IRQ_TYPE_EDGE_RISING
			SEC_GPIO_NUM(AP,gpm19,gpm19,0) 0>;
		irq-gpios = <SEC_GPIO_REF(AP,gpm19,gpm19,0) 0>;
		reset-gpios = <SEC_GPIO_REF(AP,gpm18,gpm18,0) 0>;
#if 0
		clkreq-gpios = <SEC_GPIO_REF(AP,gpa1,gpa1,1) 0>;
#endif
		st21nfc,ap_vendor = "slsi";
		i2c-retry = <1>;
#if 0
		st21nfc,nfc-det-gpio = <SEC_GPIO_REF(${nfc_check}) 0>;
#endif
#if 0
		st21nfc,late_pvdd_en;
#endif
#if 1
		nfc_pvdd-supply = <&fixed_regulator0>;
#endif

#if 0
		st21nfc,clk_req_wake;
#endif
#if 0
		st21nfc,irq_all_trigger;
#endif
#if 0
		st,clk_pinctrl;
		clocks = <&clock OSC_NFC>;
		clock-names = "nfc_ref_clk";
#endif

		pinctrl-names = "default", "nfc_nc";
/* default */
		pinctrl-0 = <&nfc_clk_req &nfc_irq &nfc_rst
#if 0
			&nfc_xclkout
#endif
#if 0
			&nfc_check
#endif
			>;
/* nfc_nc */
		pinctrl-1 = <&nfc_clk_req_nc &nfc_irq_nc &nfc_rst_nc>;
	};
};

&fixed_regulator0 {
	regulator-name = "nfc_pvdd";
};

